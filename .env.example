# Neon connection strings — copy this file to .env and fill in your values.
# The db:setup script uses DATABASE_URL_UNPOOLED for DDL (required by Neon for direct connections).
# The future build-time read layer will use DATABASE_URL (pooled, suitable for short-lived queries).

# Pooled endpoint (contains "-pooler" in the hostname)
DATABASE_URL=postgres://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Direct / unpooled endpoint (no "-pooler")
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=verify-full
