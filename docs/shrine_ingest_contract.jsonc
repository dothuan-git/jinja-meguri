// ============================================================
// SHRINE INGEST CONTRACT  v1.0
// ------------------------------------------------------------
// One JSON object per shrine. PRODUCED by research, CONSUMED by the ingest script.
// Also the MIGRATION TARGET for the ~10 legacy shrines (transform old format -> this).
//
// FIELD -> TABLE MAP (what the ingest script writes):
//   identity + location    -> shrines
//   details{}              -> shrine_details
//   ranks[]                -> shrine_ranks               (resolve code -> ranks.id)
//   prayer_categories[]    -> shrine_prayer_categories   (resolve code -> prayer_categories.id)
//   deities[]              -> deities (UPSERT on name_kanji) + shrine_deities (junction)
//   events[]               -> events + event_deities + event_occurrences
//   sources[]              -> sources
//
// SCRIPT-OWNED LOGIC (NOT the LLM's job):
//   - deity dedup: UPSERT on name_kanji; match existing canonical row, never duplicate a kami
//   - code -> id resolution for ranks & prayer_categories against the fixed catalogs
//   - PostGIS Point built from coordinates{} as ST_MakePoint(lng, lat)::geography (SRID 4326)
//   - occurrence handling: concrete rows pass straight through; lunar / "Nth-weekday"
//     events ship with occurrences:[] empty and are filled by the annual January upload
//   - REFRESH MATERIALIZED VIEW shrine_search after each batch
//
// DESIGN NOTE (deviation from brief §7 "EN/JA splitting"):
//   Research outputs PRE-SPLIT name_en / name_ja fields rather than a combined string the
//   script parses. Explicit fields map 1:1 to columns and remove a fragile parsing step.
// ============================================================
{
  "schema_version": "1.0",

  // ---- shrines -------------------------------------------------------------
  "slug": "yasaka-jinja",            // REQUIRED, unique, URL key. lowercase-hyphenated romaji.
  "name_en": "Yasaka Shrine",        // REQUIRED
  "name_ja": "八坂神社",
  "region": "Kinki",                 // must match a regions.name_en (denormalized FK on shrines)
  "prefecture": "Kyoto",             // must match a prefectures.name_en; script derives region too
  "city": "Kyoto",
  "address": "625 Gionmachi Kitagawa, Higashiyama Ward, Kyoto",
  "coordinates": { "lat": 35.0036, "lng": 135.7785 },  // REQUIRED. Also powers the map embed (q=LAT,LNG).
  "notes": null,                     // short freeform; nullable

  // ---- shrine_details (1:1, full flowing prose; NO festival summary here) --
  "details": {
    "history": "Founded in the 7th century as Gion-sha, the shrine was the cult center of the Gion faith that arose to placate epidemics. Renamed Yasaka Shrine in 1868 during the Meiji separation of Buddhism and Shinto. (...full prose...)",
    "why_visit": "The head shrine of roughly 2,300 Yasaka/Gion shrines nationwide and the spiritual home of the Gion Matsuri. (...full prose...)",
    "prayer_focus": "Protection from epidemics and misfortune (厄除け yakuyoke), prosperity in business, and good fortune. (...full prose...)",
    "best_season": "July for the Gion Matsuri; cherry blossoms in adjacent Maruyama Park in early April. (...full prose...)"
  },

  // ---- ranks (many-to-many; store ALL as rows; "highest" derived at query time) ----
  // Each entry is a CODE that MUST exist in the ranks catalog. Ingest resolves code -> id.
  "ranks": ["Beppyo-sha", "Kanpei-Taisha"],

  // ---- prayer_categories (the "strong for" facet) --------------------------
  // Each is a CODE from the fixed 24-value prayer_categories catalog.
  "prayer_categories": ["Protection", "Health", "Business"],

  // ---- deities -------------------------------------------------------------
  // Each entry mixes SHRINE-SPECIFIC data (-> shrine_deities) with an OPTIONAL
  // canonical block (-> deities). name_kanji is the dedup key.
  //
  //   canonical{} is REQUIRED ONLY when introducing a kami not yet in the deities
  //   table / canonical seed file. If the deity already exists, OMIT canonical{} —
  //   the script matches on name_kanji and leaves the canonical row untouched
  //   (canonical lore is authored once, never per-shrine).
  "deities": [
    {
      "name_romaji": "Susanoo-no-Mikoto",
      "name_kanji": "素戔嗚尊",        // REQUIRED — dedup / match key
      "is_primary": true,
      "sort_order": 1,
      "role": "Chief enshrined deity (主祭神); protector against plague and misfortune.",
      // regional_lore is PREFERRED over canonical_lore at read time (COALESCE).
      // NOTE the locked rule: the Gozu Tennō identity is SYNCRETIC LORE and lives HERE,
      // NOT in deity_type (which stays 'origin').
      "regional_lore": "At Yasaka, Susanoo was long venerated in fused identity with Gozu Tennō (牛頭天王), the Buddhist-derived deity of pestilence, until the 1868 separation restored his Shinto name. The Gion Matsuri originated as a goryō-e rite to appease him and quell epidemics. (...full prose...)",
      "canonical": {
        "domain": "Storms, sea, and the slaying of Yamata-no-Orochi",  // portfolio ONLY, no narrative
        "title": null,                                                  // NULL for primordial kami
        "deity_type": "origin",   // one of: origin | deified human | syncretic | imported
        "canonical_lore": "Born from Izanagi's nose; banished from Takamagahara, he slew the eight-headed serpent Yamata-no-Orochi and recovered the sword Kusanagi. (Kojiki / Nihon Shoki) (...full prose...)"
      }
    },
    {
      "name_romaji": "Kushinadahime-no-Mikoto",
      "name_kanji": "櫛稲田姫命",
      "is_primary": false,
      "sort_order": 2,
      "role": "Consort of Susanoo, enshrined alongside him.",
      "regional_lore": null,        // null => read layer falls back to canonical_lore
      "canonical": {
        "domain": "Rice fields and marital harmony",
        "title": null,
        "deity_type": "origin",
        "canonical_lore": "The maiden rescued by Susanoo from Yamata-no-Orochi and taken as his wife. (...full prose...)"
      }
    }
    // ...additional deities (e.g. the eight offspring 八柱御子神, handled as one collective row)...
  ],

  // ---- events --------------------------------------------------------------
  // Major / uniquely-significant festivals ONLY (skip daily & monthly rites).
  // Max 2 events may carry access_type "pilgrimage_experience".
  "events": [
    {
      "name_en": "Gion Festival",
      "name_ja": "祇園祭",
      "time_prose": "Throughout July; Yamaboko Junkō float processions on July 17 (Saki Matsuri) and July 24 (Ato Matsuri).", // DISPLAY ONLY
      "origin": "Originated in 869 as a goryō-e rite to dispel a nationwide epidemic. (...full prose...)",
      "meaning": "A purification of the city and petition for protection from pestilence. (...full prose...)",
      "ritual": "Mikoshi processions, the towering yamaboko floats, and the Yamaboko Junkō parade through central Kyoto. (...full prose...)",
      "prayer": "For freedom from disease and disaster. (...full prose...)",
      "access_type": "public_witness",   // public_witness | pilgrimage_experience
      "visitor_notes": "The float processions on the 17th and 24th draw large crowds; arrive early along Shijō-dōri. (...full prose...)",

      // event_deities: reference by kanji; role is event-specific
      "deities": [
        { "name_kanji": "素戔嗚尊", "role": "Honored deity carried in the mikoshi" }
      ],

      // event_occurrences: concrete dated rows the CALENDAR queries (range-overlap).
      // Empty [] is valid for lunar / Nth-weekday events -> filled by the January upload.
      // Fixed-Gregorian dates (like the 17th/24th) can ship here directly.
      "occurrences": [
        { "start_date": "2026-07-01", "end_date": "2026-07-31" },
        { "start_date": "2026-07-17", "end_date": "2026-07-17" },
        { "start_date": "2026-07-24", "end_date": "2026-07-24" }
      ]
    }
    // ...additional events...
  ],

  // ---- sources (provenance; Japanese-first) --------------------------------
  "sources": [
    {
      "url": "https://www.yasaka-jinja.or.jp/",
      "title": "八坂神社 公式サイト",
      "source_type": "official",      // official | wikipedia_ja | tourism | academic
      "note": "Primary source for enshrined deities and festival schedule."
    },
    {
      "url": "https://ja.wikipedia.org/wiki/八坂神社",
      "title": "八坂神社 - Wikipedia",
      "source_type": "wikipedia_ja",
      "note": null
    }
  ]
}

// ============================================================
// VALIDATION RULES (the ingest script enforces; a record failing any -> human pause)
// ------------------------------------------------------------
// REQUIRED        : slug, name_en, region, prefecture, coordinates{lat,lng},
//                   >=1 deity, and >=1 deity with is_primary:true
// UNIQUE          : slug; deity name_kanji is the global dedup key
// ENUMS           : deity_type in {origin, deified human, syncretic, imported}
//                   access_type in {public_witness, pilgrimage_experience}
//                   source_type in {official, wikipedia_ja, tourism, academic}
// CATALOG MATCH   : every ranks[] code exists in ranks; every prayer_categories[]
//                   code exists in prayer_categories; region/prefecture exist
// DATES           : every occurrence end_date >= start_date
// LIMITS          : at most 2 events with access_type "pilgrimage_experience"
// LORE RULE       : Gozu-Tennō-style syncretism belongs in regional_lore/canonical_lore,
//                   NEVER in deity_type
// CANONICAL BLOCK : present only for kami new to the deities table; omit for existing
// NO HALLUCINATION: dates, ritual names, and facts must trace to sources[]
// ============================================================
